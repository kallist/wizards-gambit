{
  "name": "wizards-gambit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server:dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src server tests scripts/*.mjs *.ts *.json index.html",
    "verify:toy": "node --import tsx scripts/verify-toy.mjs",
    "build:toy": "tsc --noEmit && vite build --mode toy --outDir dist-toy",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.js",
    "start": "node server-dist/index.js",
    "play": "node scripts/play-local.mjs",
    "test:launcher": "node --test tests/local-launcher.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
